# 複製本檔為 .env 後填入實際值（.env 已被 .gitignore 排除）

# SQLAlchemy／Alembic 連線字串（驅動為 PyMySQL）
DATABASE_URL="mysql+pymysql://academic_app:<密碼>@localhost:3306/academic_db?charset=utf8mb4"

# JWT 簽章金鑰：必須與 web/.env.local 相同，至少 32 字元
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="<隨機字串>"
JWT_EXPIRES_IN_HOURS=8

# 正式環境（HTTPS）設為 true
COOKIE_SECURE=false

# 種子帳號（admin、所有教師與學生）的初始密碼，僅供本機開發
SEED_PASSWORD="<至少 8 字元>"
