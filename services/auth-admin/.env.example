# 複製本檔為 .env 後填入實際值（.env 已被 .gitignore 排除，不會進入 git）

# 主資料庫與 Prisma Migrate 用的 shadow 資料庫（帳號需有兩個資料庫的完整權限）
DATABASE_URL="mysql://academic_app:<密碼>@localhost:3306/academic_db"
SHADOW_DATABASE_URL="mysql://academic_app:<密碼>@localhost:3306/academic_db_shadow"

# JWT 簽章金鑰：必須與 services/academic/.env、apps/web/.env.local 相同，至少 32 字元
# 產生方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="<隨機字串>"
JWT_EXPIRES_IN_HOURS=8

PORT=4000
COOKIE_SECURE=false

# 種子帳號（admin、所有教師與學生）的初始密碼，僅供本機開發
SEED_PASSWORD="<至少 8 字元>"
